{
  "name": "goraebap-workflow-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "workflow": "node plugin/manager/scripts/workflow.mjs",
    "test": "node --test plugin/tests/*.test.mjs",
    "check": "node plugin/scripts/check.mjs",
    "package:plugins": "node plugin/scripts/package-plugins.mjs",
    "frontend:check": "tsc -p frontend/tsconfig.json",
    "frontend:test": "vitest run --config frontend/vitest.config.ts",
    "frontend:icons": "node frontend/scripts/generate-icons.mjs",
    "guide": "node site/scripts/kit-tokens.mts && astro dev --root site --port 4451",
    "guide:check": "tsc -p site/tsconfig.json --noEmit",
    "guide:build": "node site/scripts/kit-tokens.mts && astro build --root site"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astryxdesign/core": "^0.5.2",
    "@astryxdesign/theme-stone": "^0.5.2",
    "@babel/parser": "^8.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/solar": "^1.2.13",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "astro": "7.4.7",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  }
}
