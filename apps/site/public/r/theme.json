{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Webcraft 토큰",
  "description": "면 네 단계(sidebar < background < card < popover) · 글자색 강조 · 업무 표식 · 일정 분류 색, Pretendard · JetBrains Mono, 64rem 분기점과 휴대폰 글자 크기, bg-dots · squircle 유틸리티. 다크 모드는 html[data-theme=dark](dark: 변형도 같다). 다른 키트 항목이 모두 이것에 기댄다. 받는 프로젝트는 Webcraft FSD 별칭(components.json의 ui · components → @/shared/ui, lib · hooks → @/shared/lib, utils → @/shared/lib/utils)을 쓴다.",
  "dependencies": [
    "pretendard",
    "@fontsource-variable/jetbrains-mono",
    "tw-animate-css"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif",
      "font-mono": "'JetBrains Mono Variable', 'SF Mono', Consolas, monospace",
      "breakpoint-md": "64rem",
      "color-row-hover": "color-mix(in srgb, var(--foreground) 4%, var(--background))",
      "color-band": "color-mix(in srgb, var(--muted) 55%, var(--background))",
      "color-unread": "color-mix(in srgb, var(--foreground) 9%, var(--background))",
      "color-unread-strong": "color-mix(in srgb, var(--foreground) 14%, var(--background))",
      "color-state-description": "color-mix(in srgb, var(--icon-muted) 75%, var(--background))",
      "radius-surface": "1rem",
      "shadow-surface": "0 1px 2px var(--shadow-color), 0 0 0 1px var(--border)"
    },
    "light": {
      "background": "#f9f9fa",
      "foreground": "#1b1b1b",
      "sidebar": "#efeff0",
      "card": "color-mix(in srgb, var(--background) 25%, #ffffff)",
      "card-foreground": "var(--foreground)",
      "popover": "color-mix(in srgb, var(--background) 15%, #ffffff)",
      "popover-foreground": "var(--foreground)",
      "primary": "var(--foreground)",
      "primary-foreground": "#ffffff",
      "secondary": "color-mix(in srgb, var(--foreground) 10%, var(--background))",
      "secondary-foreground": "var(--foreground)",
      "muted": "#ececed",
      "muted-foreground": "#5c5c5e",
      "accent": "color-mix(in srgb, var(--foreground) 4%, transparent)",
      "accent-foreground": "var(--foreground)",
      "destructive": "oklch(0.577 0.245 27.325)",
      "border": "color-mix(in srgb, var(--foreground) 13%, var(--background))",
      "input": "color-mix(in srgb, var(--foreground) 18%, var(--background))",
      "ring": "color-mix(in srgb, var(--foreground) 72%, var(--background))",
      "icon-muted": "#6b6b6f",
      "pressed": "color-mix(in srgb, var(--foreground) 7%, transparent)",
      "shadow-color": "rgb(0 0 0 / 0.04)",
      "chart-1": "oklch(0.87 0 0)",
      "chart-2": "oklch(0.556 0 0)",
      "chart-3": "oklch(0.439 0 0)",
      "chart-4": "oklch(0.371 0 0)",
      "chart-5": "oklch(0.269 0 0)",
      "radius": "0.5rem",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-primary": "var(--foreground)",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "var(--pressed)",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "var(--border)",
      "sidebar-ring": "var(--ring)",
      "mark-backlog": "#d7d7da",
      "mark-progress": "#524622",
      "mark-done": "#374c36",
      "mark-urgent": "#c62f39",
      "mark-high": "#b8550b",
      "mark-medium": "#8b6900",
      "mark-low": "#2865c3",
      "illustration-accent": "#4a7fd4",
      "event-blue": "#d7e4f5",
      "event-blue-foreground": "#3c4856",
      "event-green": "#d0e9ce",
      "event-green-foreground": "#374c36",
      "event-orange": "#ffdcbb",
      "event-orange-foreground": "#5b4227",
      "event-purple": "#e8dff3",
      "event-purple-foreground": "#4b4454",
      "event-red": "#f9dcd7",
      "event-red-foreground": "#58413e",
      "event-teal": "#d4e7dc",
      "event-teal-foreground": "#3b4a41",
      "event-pink": "#f0dde8",
      "event-pink-foreground": "#52424c",
      "event-yellow": "#f4e1b7",
      "event-yellow-foreground": "#524622",
      "event-gray": "#e3e3e4",
      "event-gray-foreground": "#46464b",
      "day-off": "#d1242f",
      "saturday": "#0969da"
    }
  },
  "css": {
    "@import \"pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css\"": {},
    "@import \"@fontsource-variable/jetbrains-mono\"": {},
    "@custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *))": {},
    "@custom-variant compact (&:where([data-density=compact] *))": {},
    ":root": {
      "--text-sm": "0.8125rem",
      "--text-sm--line-height": "1.5",
      "--text-base": "0.9375rem",
      "--text-base--line-height": "1.6"
    },
    "[data-theme=dark]": {
      "--background": "#121213",
      "--foreground": "#f7f8f8",
      "--sidebar": "#09090a",
      "--card": "color-mix(in srgb, var(--foreground) 3%, var(--background))",
      "--popover": "color-mix(in srgb, var(--foreground) 6%, var(--background))",
      "--primary-foreground": "color-mix(in srgb, var(--background) 85%, #000000)",
      "--secondary": "color-mix(in srgb, var(--foreground) 13%, var(--background))",
      "--muted": "#232326",
      "--muted-foreground": "#8a8f98",
      "--accent": "color-mix(in srgb, var(--foreground) 5%, transparent)",
      "--destructive": "oklch(0.704 0.191 22.216)",
      "--border": "color-mix(in srgb, var(--foreground) 11%, var(--background))",
      "--input": "color-mix(in srgb, var(--foreground) 16%, var(--background))",
      "--icon-muted": "#8a8f98",
      "--pressed": "color-mix(in srgb, var(--foreground) 8%, transparent)",
      "--shadow-color": "rgb(0 0 0 / 0.3)",
      "--sidebar-primary-foreground": "var(--primary-foreground)",
      "--mark-backlog": "#5e5e61",
      "--mark-progress": "#d7c59c",
      "--mark-done": "#b4cdb2",
      "--mark-urgent": "#f17880",
      "--mark-high": "#efa15f",
      "--mark-medium": "#e6c45b",
      "--mark-low": "#79a7ee",
      "--illustration-accent": "#6ea2ef",
      "--event-blue": "#485362",
      "--event-blue-foreground": "#d7e4f5",
      "--event-green": "#425841",
      "--event-green-foreground": "#d0e9ce",
      "--event-orange": "#684d32",
      "--event-orange-foreground": "#ffdcbb",
      "--event-purple": "#564f60",
      "--event-purple-foreground": "#e8dff3",
      "--event-red": "#644d49",
      "--event-red-foreground": "#f9dcd7",
      "--event-teal": "#46564d",
      "--event-teal-foreground": "#d4e7dc",
      "--event-pink": "#5e4e57",
      "--event-pink-foreground": "#f0dde8",
      "--event-yellow": "#5e512d",
      "--event-yellow-foreground": "#f4e1b7",
      "--event-gray": "#303032",
      "--event-gray-foreground": "#e2e2e8",
      "--day-off": "#ff7b72",
      "--saturday": "#6cb6ff"
    },
    "@media not all and (min-width: 64rem)": {
      ":root": {
        "--text-xs": "0.8125rem",
        "--text-sm": "0.9375rem",
        "--text-base": "1.0625rem"
      }
    },
    "@utility bg-dots": {
      "background-image": "radial-gradient(color-mix(in srgb, var(--foreground) 12%, transparent) 1px, transparent 1px)",
      "background-size": "1rem 1rem"
    },
    "@utility squircle": {
      "corner-shape": "squircle"
    },
    "@layer base": {
      "@keyframes page-state-enter": {
        "from": {
          "opacity": "0",
          "transform": "translateY(0.375rem)"
        },
        "to": {
          "opacity": "1",
          "transform": "none"
        }
      },
      "body": {
        "font-weight": "450"
      },
      "html": {
        "@apply font-sans": {}
      },
      "@media (min-width: 1920px)": {
        "html": {
          "font-size": "max(100%, min(118.75%, 19px, calc(100% + 0.46875vw - 9px)))"
        }
      },
      "*": {
        "scrollbar-width": "thin",
        "scrollbar-color": "color-mix(in srgb, var(--foreground) 16%, transparent) transparent"
      },
      "*:hover": {
        "scrollbar-color": "color-mix(in srgb, var(--foreground) 28%, transparent) transparent"
      }
    }
  },
  "docs": "다크 모드는 html[data-theme=dark]입니다. shadcn init이 남긴 .dark { … } 블록과 @custom-variant dark (&:is(.dark *)) 줄은 지웁니다(뒤에 더한 data-theme 변형과 겹칩니다). 모드는 @webcraft/appearance가 data-theme에 반영합니다.",
  "type": "registry:theme"
}