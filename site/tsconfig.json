{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node",
      "@vitest/browser-playwright"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@samples/*": [
        "./samples/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "samples",
    "content-plugin.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "stylex-plugin.ts"
  ],
  "exclude": [
    "dist"
  ]
}
