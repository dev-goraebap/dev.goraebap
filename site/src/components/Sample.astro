---
// 규칙 옆에 견본 하나를 띄운다. 예: <Sample id="playground-peek/open" />
// 견본은 실제 기기 폭(휴대폰 390px, 데스크톱은 키트가 데스크톱으로 판정하는 최소 폭 1024px)으로 그리고, 본문 칸이 더 좁으면 비율대로 줄여 보인다.
// 키트는 창 폭으로 휴대폰을 판정하므로, 좁은 본문 칸에 그대로 넣으면 데스크톱 견본이 휴대폰 화면으로 바뀌기 때문이다.
import { sampleInfo } from '../samples';

interface Props {
  id: string;
  /** 견본 이름 대신 붙일 설명 */
  caption?: string;
}
const { id, caption } = Astro.props;
const entry = await sampleInfo(id);
const src = `/samples/${entry.id}/`;
const isPhone = entry.device === 'phone';
const isScreen = entry.layout === 'fullscreen' || isPhone;
const width = isPhone ? 390 : 1024;
const rem = (value?: string) => (value?.endsWith('rem') ? Math.round(parseFloat(value) * 16) : undefined);
// 높이를 정하지 않은 부품 견본은 iframe이 알려 주는 내용 높이를 따른다.
const height = rem(entry.height) ?? (isPhone ? 844 : isScreen ? 760 : undefined);
---
<figure class="sample" data-device={entry.device}>
  <guide-sample class="sample-stage" data-width={width} data-height={height ?? 160} data-auto={height ? undefined : ''}>
    <iframe data-src={src} title={`견본: ${entry.name}`}></iframe>
    <span class="sample-wait" aria-hidden="true">견본을 불러오는 중</span>
  </guide-sample>
  <figcaption>
    <span>{caption ?? entry.name}{isPhone ? ' · 휴대폰 폭' : ''}</span>
    <a href={src} target="_blank" rel="noopener">새 창에서 열기</a>
  </figcaption>
</figure>

<script>
  // 화면 견본은 문서 폭 전체를, 부품 견본은 내용 폭을 칸에 맞춘다. 부품이 칸보다 좁으면 줄이지 않고 가운데만 보인다.
  // 사용자 정의 요소라서 본문이 다시 붙어도(앱 셸이 본문을 다시 그릴 때) 붙을 때마다 스스로 맞춘다.
  class GuideSample extends HTMLElement {
    observer = new ResizeObserver(() => this.fit());
    seen = new IntersectionObserver((items) => { if (items.some((item) => item.isIntersecting)) this.load(); }, { rootMargin: '200px' });
    connectedCallback() {
      this.style.display = 'block';
      this.observer.observe(this);
      this.fit();
      // 앱 셸이 화면을 넘겨받는 동안 본문이 다시 붙을 수 있다. 그 뒤에 보이는 견본만 불러와 iframe을 두 번 싣지 않는다.
      const island = this.closest('astro-island');
      const ready = () => this.isConnected && this.seen.observe(this);
      if (!island?.hasAttribute('ssr')) { ready(); return; }
      const wait = new MutationObserver(() => { if (!island.hasAttribute('ssr')) { wait.disconnect(); setTimeout(ready, 0); } });
      wait.observe(island, { attributes: true, attributeFilter: ['ssr'] });
    }
    disconnectedCallback() { this.observer.disconnect(); this.seen.disconnect(); }
    load() {
      const frame = this.querySelector('iframe');
      this.seen.disconnect();
      if (!frame || frame.src || !frame.dataset.src) return;
      frame.addEventListener('load', () => this.setAttribute('data-loaded', ''), { once: true });
      frame.src = frame.dataset.src;
    }
    fit() {
      const frame = this.querySelector('iframe');
      if (!frame) return;
      const width = Number(this.dataset.width);
      const height = Number(this.dataset.height);
      const visible = this.dataset.content ? Number(this.dataset.content) + 32 : width;
      const scale = Math.min(1, this.clientWidth / visible);
      frame.style.inlineSize = `${width}px`;
      frame.style.blockSize = `${height}px`;
      frame.style.transform = scale < 1 ? `scale(${scale})` : '';
      frame.style.marginInlineStart = `${this.clientWidth / 2 - (width * scale) / 2}px`;
      this.style.blockSize = `${Math.ceil(height * scale)}px`;
    }
  }
  if (!customElements.get('guide-sample')) customElements.define('guide-sample', GuideSample);
  window.addEventListener('message', (event) => {
    if (event.origin !== location.origin || event.data?.type !== 'sample-size') return;
    for (const stage of document.querySelectorAll<GuideSample>('guide-sample[data-auto]')) {
      if (stage.querySelector('iframe')?.contentWindow !== event.source) continue;
      stage.dataset.height = String(Math.ceil(event.data.height));
      stage.dataset.content = String(Math.ceil(event.data.width));
      stage.fit();
    }
  });
</script>
