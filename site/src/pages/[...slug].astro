---
// 모든 문서 주소. 틀은 GuideLayout이 맡는다. 묶음 주소(/app-shell/ 등)는 그 묶음의 첫 문서로 보낸다.
import { getCollection, render } from 'astro:content';
import type { GuidePageData } from '../guide/GuideShell';
import GuideLayout from '../guide/GuideLayout.astro';
import { groupEntries, guidePages } from '../guide/nav';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const pages = await guidePages();
  const slug = (path: string) => (path === '/' ? undefined : path.replace(/^\/|\/$/g, ''));
  const docPaths = docs.map((doc) => {
    const page = pages.find((item) => item.id === doc.id);
    return { params: { slug: doc.id === 'index' ? undefined : slug(page?.path ?? `/${doc.id}/`) }, props: { id: doc.id } };
  });
  const groups = (await groupEntries()).map((group) => ({ params: { slug: slug(group.path) }, props: { redirect: group.first } }));
  return [...docPaths, ...groups];
}

const { id, redirect } = Astro.props as { id?: string; redirect?: string };
if (redirect) return Astro.redirect(redirect);
const doc = (await getCollection('docs')).find((item) => item.id === id)!;
const { Content, headings } = await render(doc);
const page = (await guidePages()).find((item) => item.id === doc.id);
const title = doc.data.title;
const data: GuidePageData = {
  path: page?.path ?? '/',
  title,
  crumbs: page && page.path !== '/' ? [{ label: page.group, href: page.groupPath }] : [],
  headings: headings.map((heading) => ({ id: heading.slug, label: heading.text, level: heading.depth })),
};
---
<GuideLayout title={title} pageTitle={page?.path === '/' ? title : `${title} · 고래밥 화면 규칙`} description={doc.data.description} data={data}>
  <Content />
</GuideLayout>
