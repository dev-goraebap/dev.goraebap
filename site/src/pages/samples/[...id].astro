---
// 견본 하나를 가이드와 분리된 문서로 그린다. 가이드 본문은 이 주소를 iframe으로 띄우고, 새 창에서도 열 수 있다.
import { SampleFrame } from '../../components/SampleFrame';
import { allSamples } from '../../samples';

export async function getStaticPaths() {
  return (await allSamples()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<!doctype html>
<html lang="ko" data-scales={entry.layout !== 'fullscreen' && entry.device !== 'phone' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{entry.name} · {entry.title.split('/').at(-1)}</title>
    <style is:global>html, body { margin: 0; }</style>
    <script is:inline>
      // 견본이 뜨기 전에도 가이드와 같은 모드로 그려 다크 화면에 흰 틀이 비치지 않게 한다.
      (() => {
        let mode;
        try { mode = window.parent !== window ? window.parent.document.documentElement.dataset.theme : undefined; } catch {}
        try { mode = mode || localStorage.getItem('guide-theme'); } catch {}
        if (mode !== 'dark' && mode !== 'light') mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.style.colorScheme = mode;
        // 큰 화면에서 가이드는 루트 글자를 키운다(키트 base.css). 견본 iframe은 폭이 1024px라 그 규칙을 받지 못하므로
        // 부품 견본은 가이드의 루트 글자 크기를 그대로 쓴다. 앱 화면 견본은 셸이 창 폭으로 크기를 정하므로 두지 않는다.
        try {
          if (window.parent !== window && document.documentElement.hasAttribute('data-scales')) {
            document.documentElement.style.fontSize = getComputedStyle(window.parent.document.documentElement).fontSize;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <SampleFrame client:only="react" id={entry.id} />
  </body>
</html>
