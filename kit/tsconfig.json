{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "@vitest/browser-playwright"],
    "resolveJsonModule": true,
    "paths": {
      "@kit/*": ["./reference/*"],
      "@samples/*": ["./samples/*"],
      "@guide/*": ["./guide/src/*"]
    }
  },
  "include": ["reference", "samples", "guide/src", "guide/content-plugin.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["guide/dist"]
}
