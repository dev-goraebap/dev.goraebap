{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/accounts": {
      "entry": ["src/pages/**/{__root,route,page}.tsx"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/blog": {
      "entry": ["src/routes/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/productivity": {
      "ignore": ["**/*"]
    },
    "packages/design-system": {
      "entry": ["src/lib/*.ts", "src/recipes/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
      "ignoreDependencies": ["lucide-react"]
    }
  }
}
