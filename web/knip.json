{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/react-tanstack-demo": {
      "entry": ["src/main.tsx"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/angular-demo": {
      "entry": ["src/main.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/blog": {
      "entry": [
        "src/pages/**/{__root,route,page}.tsx",
        "src/app/entry-server.tsx",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/design-system": {
      "entry": ["src/lib/*.ts", "src/recipes/*.ts"]
    },
    "packages/ui-react": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
      "ignoreDependencies": ["lucide-react"]
    },
    "packages/ui-angular": {
      "entry": ["src/index.ts"]
    }
  }
}
