{
  "name": "@goraebap/web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:blog": "pnpm --filter @goraebap/blog dev",
    "dev:react-demo": "pnpm --filter @goraebap/react-tanstack-demo dev",
    "dev:angular-demo": "pnpm --filter @goraebap/angular-demo dev",
    "build:blog": "pnpm --filter @goraebap/blog build",
    "build:react-demo": "pnpm --filter @goraebap/react-tanstack-demo build",
    "build:angular-demo": "pnpm --filter @goraebap/angular-demo build",
    "build:demos": "pnpm build:react-demo && pnpm build:angular-demo && node scripts/assemble-demos.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build && node scripts/assemble-demos.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm knip && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.0.0",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.73.0"
  }
}
