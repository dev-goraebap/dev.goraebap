{
  "name": "@goraebap/productivity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint:ui": "node scripts/check-ui.mjs",
    "lint": "eslint .",
    "knip": "knip",
    "test": "node --test scripts/*.test.mjs",
    "check": "pnpm run lint:ui && pnpm run lint && pnpm run knip && pnpm test && pnpm run build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:ui": "node scripts/generate-ui-icons.mjs",
    "api:generate": "openapi-typescript ../../../server/openapi.json -o src/shared/api/schema.d.ts",
    "screens": "node scripts/screens.mjs",
    "icons:editor": "node scripts/generate-editor-icons.mjs",
    "layout:check": "node scripts/layout-shift.mjs",
    "editor-menu:check": "node scripts/editor-menu-check.mjs",
    "print-body:check": "node scripts/print-body-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@goraebap/design-system": "workspace:*",
    "@goraebap/ui-react": "workspace:*",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@paper-design/shaders": "0.0.76",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.2",
    "diff": "8.0.4",
    "katex": "0.19.1",
    "lottie-web": "5.13.0",
    "lowlight": "3.3.0",
    "mermaid": "12.2.0",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.3",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "3.33.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/solar": "^1.2.13",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "^22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
