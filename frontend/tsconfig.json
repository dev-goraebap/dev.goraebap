{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "@vitest/browser-playwright"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@kit/*": [
        "./reference/*"
      ]
    }
  },
  "include": [
    "src",
    "reference",
    "vitest.config.ts"
  ]
}
