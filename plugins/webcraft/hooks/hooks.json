{
  "description": "Webcraft 새 판이 있으면 세션을 시작할 때 알리고 갱신을 제안합니다(하루 한 번 확인).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/update-check.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
