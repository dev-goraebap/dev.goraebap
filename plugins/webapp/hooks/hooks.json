{
  "description": "Webapp 새 버전이 있으면 세션을 시작할 때 알리고(하루 한 번 확인), 프로젝트가 따르는 어댑터의 파일 목록을 맥락에 넣습니다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/update-check.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/adapter-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
