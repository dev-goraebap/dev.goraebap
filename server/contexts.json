{
  "about": "서버의 컨텍스트 맵. 테스트(ContextMapTest)가 이 파일을 읽어 경계를 지키고, 그림도 이 파일에서 만든다. subdomain과 group은 판단이므로 틀렸다고 보이면 고친다. tables, views, uses는 코드와 다르면 테스트가 실패한다.",
  "base": "xyz.goraebap",
  "assembly": ["xyz.goraebap.app", "xyz.goraebap.workspace"],
  "shared": ["xyz.goraebap.foundation.shared"],
  "jooq": ["xyz.goraebap.foundation.jooq", "xyz.goraebap.foundation.jooq.logs", "xyz.goraebap.workspace.jooq"],
  "contexts": {
    "user": {
      "package": "xyz.goraebap.foundation.user",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "사용자, 로그인, 역할, 에이전트 토큰",
      "tables": ["users", "user_role", "iam_session", "iam_otp", "iam_permission_lock", "agent_profile", "agent_token"],
      "views": ["user_public"],
      "uses": ["file", "mcp"]
    },
    "file": {
      "package": "xyz.goraebap.foundation.file",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "파일 저장, 올리기, 첨부",
      "tables": ["blob", "pending_upload", "attachment"],
      "views": [],
      "uses": ["mcp"]
    },
    "notification": {
      "package": "xyz.goraebap.foundation.notification",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "알림함과 웹 푸시",
      "tables": ["notification_event", "notification_recipient", "push_subscription", "push_preference", "push_delivery"],
      "views": [],
      "uses": ["user", "realtime"]
    },
    "system": {
      "package": "xyz.goraebap.foundation.system",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "활동 기록, 요청 통계, 서버 오류, 로그 백업",
      "tables": ["activity", "request_hour", "server_error", "log_backup", "screen_visit"],
      "views": [],
      "uses": ["user"]
    },
    "seed": {
      "package": "xyz.goraebap.foundation.seed",
      "group": "foundation",
      "subdomain": "supporting",
      "summary": "초기 자료 들이기",
      "tables": ["seed_import"],
      "views": [],
      "uses": ["user"]
    },
    "realtime": {
      "package": "xyz.goraebap.foundation.realtime",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "화면에 변경을 알리는 신호",
      "tables": [],
      "views": [],
      "uses": []
    },
    "search": {
      "package": "xyz.goraebap.foundation.search",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "통합 검색의 확장점",
      "tables": [],
      "views": [],
      "uses": []
    },
    "mcp": {
      "package": "xyz.goraebap.foundation.mcp",
      "group": "foundation",
      "subdomain": "generic",
      "summary": "에이전트 도구의 확장점",
      "tables": [],
      "views": [],
      "uses": []
    },
    "project": {
      "package": "xyz.goraebap.workspace.project",
      "group": "workspace",
      "subdomain": "core",
      "summary": "프로젝트, 구성원, 키",
      "tables": ["project", "project_favorite", "project_key", "project_member"],
      "views": ["project_public", "project_key_public"],
      "uses": ["user", "realtime", "mcp"]
    },
    "issue": {
      "package": "xyz.goraebap.workspace.issue",
      "group": "workspace",
      "subdomain": "core",
      "summary": "이슈, 보드, 주기, 저장한 보기, 코드 연동",
      "tables": ["issue", "issue_column", "issue_cycle", "issue_cycle_settings", "issue_label", "issue_label_link", "issue_time_entry", "issue_view", "issue_view_order", "work_item_type", "code_link", "integration_rule", "repository_integration"],
      "views": [],
      "uses": ["project", "activity", "richbody", "user", "file", "notification", "realtime", "search", "mcp", "seed"]
    },
    "document": {
      "package": "xyz.goraebap.workspace.document",
      "group": "workspace",
      "subdomain": "core",
      "summary": "문서, 폴더, 라벨, 매뉴얼, 권한",
      "tables": ["document", "document_folder", "document_grant", "document_label", "document_label_link", "document_library_order", "document_view", "manual_chapter"],
      "views": [],
      "uses": ["project", "activity", "richbody", "user", "file", "realtime", "search", "mcp", "seed"]
    },
    "richbody": {
      "package": "xyz.goraebap.workspace.richbody",
      "group": "workspace",
      "subdomain": "supporting",
      "summary": "본문 블록, 버전, 함께 편집",
      "tables": ["rich_body", "rich_body_revision", "rich_block", "rich_block_change", "document_editing"],
      "views": [],
      "uses": ["activity", "user", "file", "realtime"]
    },
    "activity": {
      "package": "xyz.goraebap.workspace.activity",
      "group": "workspace",
      "subdomain": "supporting",
      "summary": "댓글과 변경 이력",
      "tables": ["activity_entry"],
      "views": ["activity_entry_public"],
      "uses": ["user"]
    }
  }
}
