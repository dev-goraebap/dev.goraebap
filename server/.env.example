# Optional. A local run needs none of this: copy to .env only to change a default.
#
# Without any setting the server keeps the SQLite database and uploaded files under server/data/, makes its session
# key and browser push keys on first start (server/data/secrets.properties), accepts the screens on
# http://localhost:4402, and writes login codes to its log instead of mailing them.

# The SQLite database file (git ignores server/data/).
# DB_PATH=./data/cowork.db
# Uploaded files when no STORAGE_ENDPOINT is set.
# STORAGE_LOCAL_ROOT=./data/files

# Sign in by picking an employee instead of a mailed code (dev profile only).
# AUTH_DEV_LOGIN=true

# Mail login codes through a real server instead of the log.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=

# Meeting minutes: transcription and summary stay off without these.
# APP_MEETING_ASSEMBLYAI_API_KEY=
# APP_MEETING_ANTHROPIC_API_KEY=

# false when another server already runs the daily jobs on the same database.
# APP_JOBS_ENABLED=true
